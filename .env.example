# Database connection string
# For Supabase (Recommended): postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# For Local Docker: postgresql://postgres:postgres@localhost:5432/code_rag
DATABASE_URL=postgresql://postgres:password@localhost:5432/code_rag

# Google Gemini API Key for answer generation
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
